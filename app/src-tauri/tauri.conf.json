{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dolmen",
  "identifier": "dev.dolmendb.dolmen",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dolmen",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Dolmen contributors",
    "copyright": "Copyright 2026 Dolmen contributors",
    "license": "Apache-2.0",
    "licenseFile": "../../LICENSE",
    "homepage": "https://github.com/whalebanana86/ai-dolmen",
    "category": "DeveloperTool",
    "shortDescription": "An AI-native database client with schema version control",
    "longDescription": "Dolmen is an open-source database client for PostgreSQL: a SQL editor with tabs and history, table details, relationships and ERD, query plans, schema snapshots versioned in Git, protection for production databases, and AI that writes, explains and fixes SQL with your own Anthropic API key.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
